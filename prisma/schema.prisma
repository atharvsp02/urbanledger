generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccessRole {
  ADMIN
  ACCOUNTANT
  CONTACT
}

enum UserStatus {
  PROVISIONING
  ACTIVE
  DISABLED
}

enum PortalAccessStatus {
  ACTIVE
  REVOKED
}

enum ProvisioningKind {
  PUBLIC_ACCOUNTANT
  ADMIN
  CONTACT
}

enum ProvisioningState {
  PENDING
  AUTH_CREATED
  COMPLETED
  FAILED
}

enum ContactKind {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductKind {
  GOODS
  SERVICE
  COMBO
}

enum OrderKind {
  PURCHASE
  SALES
}

enum OrderState {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum FinancialDocumentKind {
  VENDOR_BILL
  CUSTOMER_INVOICE
}

enum FinancialDocumentState {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentDirection {
  CUSTOMER_INCOMING
  VENDOR_OUTGOING
}

enum PaymentSourceMode {
  STAFF
  PORTAL_SIMULATION
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EXPENSE
  INCOME
  CAPITAL
}

enum AccountSubtype {
  GENERAL
  CASH
  BANK
  RECEIVABLE
  PAYABLE
  INPUT_TAX
  OUTPUT_TAX
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
  GENERAL
  OPENING
}

enum TaxScope {
  SALES
  PURCHASE
  BOTH
}

enum AnalyticType {
  INCOME
  EXPENSE
}

enum EntryState {
  DRAFT
  POSTED
}

enum EntrySource {
  OPENING
  MANUAL
  CUSTOMER_INVOICE
  VENDOR_BILL
  CUSTOMER_PAYMENT
  VENDOR_PAYMENT
  REVERSAL
}

enum SequenceKind {
  PURCHASE_ORDER
  SALES_ORDER
  PURCHASE_RECEIPT
  SALES_DELIVERY
  CUSTOMER_INVOICE
  VENDOR_BILL
  CUSTOMER_PAYMENT
  VENDOR_PAYMENT
  JOURNAL_ENTRY
}

model Business {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                  @unique @db.VarChar(64)
  name                 String                  @db.VarChar(160)
  currency             String                  @default("INR") @db.Char(3)
  timezone             String                  @default("Asia/Kolkata") @db.VarChar(64)
  fiscalYearStartMonth Int                     @default(4)
  fiscalYearStartDay   Int                     @default(1)
  accountingLockDate   DateTime?               @db.Date
  readyAt              DateTime?               @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)
  staffGrants          StaffGrant[]
  portalAccess         PortalAccess[]
  provisioning         ProvisioningOperation[]
  contacts             Contact[]
  productCategories    ProductCategory[]
  products             Product[]
  orders               Order[]
  purchaseReceipts     PurchaseReceipt[]
  salesDeliveries      SalesDelivery[]
  inventoryMovements   InventoryMovement[]
  financialDocuments   FinancialDocument[]
  paymentAttempts      PaymentAttempt[]
  payments             Payment[]
  ledgerAccounts       LedgerAccount[]
  journals             Journal[]
  taxes                Tax[]
  analyticAccounts     AnalyticAccount[]
  budgets              Budget[]
  fileAssets           FileAsset[]
  entries              JournalEntry[]
  sequences            DocumentSequence[]
  operations           CommandOperation[]
  auditEvents          AuditEvent[]

  @@map("businesses")
}

model ApplicationUser {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerUserId            String                  @unique @db.Uuid
  loginId                   String                  @db.VarChar(12)
  normalizedLoginId         String                  @unique @db.VarChar(12)
  normalizedEmail           String                  @unique @db.VarChar(320)
  displayName               String                  @db.VarChar(160)
  status                    UserStatus              @default(PROVISIONING)
  mustChangePassword        Boolean                 @default(false)
  disabledAt                DateTime?               @db.Timestamptz(6)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  staffGrants               StaffGrant[]            @relation("GrantUser")
  issuedStaffGrants         StaffGrant[]            @relation("GrantIssuer")
  portalAccess              PortalAccess?           @relation("PortalUser")
  issuedPortalAccess        PortalAccess[]          @relation("PortalIssuer")
  provisioningOperations    ProvisioningOperation[] @relation("ProvisioningActor")
  responsibleBudgets        Budget[]                @relation("BudgetResponsible")
  createdOrders             Order[]                 @relation("OrderCreator")
  createdPurchaseReceipts   PurchaseReceipt[]       @relation("PurchaseReceiptCreator")
  createdSalesDeliveries    SalesDelivery[]         @relation("SalesDeliveryCreator")
  createdFinancialDocuments FinancialDocument[]     @relation("FinancialDocumentCreator")
  createdPaymentAttempts    PaymentAttempt[]        @relation("PaymentAttemptCreator")
  createdPayments           Payment[]               @relation("PaymentCreator")
  reversedPayments          Payment[]               @relation("PaymentReverser")
  allocationReversals       AllocationReversal[]    @relation("AllocationReversalCreator")
  createdEntries            JournalEntry[]          @relation("EntryCreator")
  commandOperations         CommandOperation[]      @relation("CommandActor")
  auditEvents               AuditEvent[]            @relation("AuditActor")

  @@index([status])
  @@map("application_users")
}

model StaffGrant {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  businessId  String           @db.Uuid
  role        AccessRole
  validFrom   DateTime         @default(now()) @db.Timestamptz(6)
  validUntil  DateTime?        @db.Timestamptz(6)
  revokedAt   DateTime?        @db.Timestamptz(6)
  grantedById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  user        ApplicationUser  @relation("GrantUser", fields: [userId], references: [id], onDelete: Restrict)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  grantedBy   ApplicationUser? @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, businessId, role])
  @@index([businessId, role, revokedAt])
  @@map("staff_grants")
}

model PortalAccess {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @unique @db.Uuid
  businessId  String             @db.Uuid
  contactId   String             @unique @db.Uuid
  status      PortalAccessStatus @default(ACTIVE)
  grantedById String?            @db.Uuid
  grantedAt   DateTime           @default(now()) @db.Timestamptz(6)
  revokedAt   DateTime?          @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  user        ApplicationUser    @relation("PortalUser", fields: [userId], references: [id], onDelete: Restrict)
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  grantedBy   ApplicationUser?   @relation("PortalIssuer", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@map("portal_access")
}

model ProvisioningOperation {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String?           @db.Uuid
  actorUserId       String?           @db.Uuid
  operationKey      String            @unique @db.Uuid
  kind              ProvisioningKind
  normalizedLoginId String            @db.VarChar(12)
  normalizedEmail   String            @db.VarChar(320)
  requestHash       String            @db.Char(64)
  providerUserId    String?           @db.Uuid
  state             ProvisioningState @default(PENDING)
  safeFailureCode   String?           @db.VarChar(64)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  business          Business?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor             ApplicationUser?  @relation("ProvisioningActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([normalizedLoginId])
  @@index([normalizedEmail])
  @@map("provisioning_operations")
}

model Contact {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String              @db.Uuid
  kind               ContactKind
  name               String              @db.VarChar(160)
  email              String?             @db.VarChar(320)
  mobile             String?             @db.VarChar(32)
  street             String?             @db.VarChar(240)
  city               String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  pincode            String?             @db.VarChar(16)
  imageAssetId       String?             @unique @db.Uuid
  revision           Int                 @default(1)
  archivedAt         DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  imageAsset         FileAsset?          @relation("ContactImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  portalAccess       PortalAccess?
  journalItems       JournalItem[]
  orders             Order[]
  purchaseReceipts   PurchaseReceipt[]
  salesDeliveries    SalesDelivery[]
  financialDocuments FinancialDocument[]
  paymentAttempts    PaymentAttempt[]
  payments           Payment[]

  @@index([businessId, kind, archivedAt])
  @@index([businessId, name])
  @@map("contacts")
}

model ProductCategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @db.Uuid
  name       String    @db.VarChar(120)
  archivedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([businessId, name])
  @@map("product_categories")
}

model Product {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String                  @db.Uuid
  categoryId             String                  @db.Uuid
  name                   String                  @db.VarChar(160)
  sku                    String?                 @db.VarChar(64)
  kind                   ProductKind
  salesPrice             Decimal                 @db.Decimal(20, 4)
  purchaseCost           Decimal                 @db.Decimal(20, 4)
  revision               Int                     @default(1)
  archivedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category               ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderLines             OrderLine[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  salesDeliveryLines     SalesDeliveryLine[]
  inventoryMovements     InventoryMovement[]
  financialDocumentLines FinancialDocumentLine[]

  @@unique([businessId, sku])
  @@index([businessId, kind, archivedAt])
  @@map("products")
}

model Order {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String              @db.Uuid
  kind               OrderKind
  contactId          String              @db.Uuid
  number             String              @db.VarChar(40)
  orderDate          DateTime            @db.Date
  state              OrderState          @default(DRAFT)
  netTotal           Decimal             @db.Decimal(20, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(20, 2)
  total              Decimal             @db.Decimal(20, 2)
  revision           Int                 @default(1)
  createdById        String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy          ApplicationUser     @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines              OrderLine[]
  purchaseReceipt    PurchaseReceipt?
  salesDelivery      SalesDelivery?
  financialDocuments FinancialDocument[]

  @@unique([businessId, kind, number])
  @@index([businessId, kind, state, orderDate])
  @@index([contactId])
  @@map("orders")
}

model OrderLine {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String                  @db.Uuid
  productId              String                  @db.Uuid
  productNameSnapshot    String                  @db.VarChar(160)
  productKindSnapshot    ProductKind
  quantity               Decimal                 @db.Decimal(16, 4)
  unitPriceSnapshot      Decimal                 @db.Decimal(20, 4)
  lineTotal              Decimal                 @db.Decimal(20, 2)
  taxId                  String?                 @db.Uuid
  taxNameSnapshot        String?                 @db.VarChar(120)
  taxRateSnapshot        Decimal?                @db.Decimal(7, 4)
  taxRevisionSnapshot    Int?
  taxAccountIdSnapshot   String?                 @db.Uuid
  taxAmount              Decimal                 @default(0) @db.Decimal(20, 2)
  grossTotal             Decimal                 @db.Decimal(20, 2)
  analyticAccountId      String?                 @db.Uuid
  position               Int
  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceiptLine    PurchaseReceiptLine?
  salesDeliveryLine      SalesDeliveryLine?
  financialDocumentLines FinancialDocumentLine[]
  tax                    Tax?                    @relation(fields: [taxId], references: [id], onDelete: Restrict)
  analyticAccount        AnalyticAccount?        @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
  @@index([productId])
  @@index([taxId])
  @@index([analyticAccountId])
  @@map("order_lines")
}

model PurchaseReceipt {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String                @db.Uuid
  orderId                   String                @unique @db.Uuid
  contactId                 String                @db.Uuid
  number                    String                @db.VarChar(40)
  receiptDate               DateTime              @db.Date
  sourceOrderNumberSnapshot String                @db.VarChar(40)
  sourceOrderDateSnapshot   DateTime              @db.Date
  contactNameSnapshot       String                @db.VarChar(160)
  createdById               String                @db.Uuid
  createdAt                 DateTime              @default(now()) @db.Timestamptz(6)
  business                  Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order                     Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contact                   Contact               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy                 ApplicationUser       @relation("PurchaseReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines                     PurchaseReceiptLine[]

  @@unique([businessId, number])
  @@index([businessId, receiptDate])
  @@index([contactId])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId           String             @db.Uuid
  sourceOrderLineId   String             @unique @db.Uuid
  productId           String             @db.Uuid
  productNameSnapshot String             @db.VarChar(160)
  productKindSnapshot ProductKind
  quantity            Decimal            @db.Decimal(16, 4)
  position            Int
  receipt             PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  sourceOrderLine     OrderLine          @relation(fields: [sourceOrderLineId], references: [id], onDelete: Restrict)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement   InventoryMovement?

  @@unique([receiptId, position])
  @@index([productId])
  @@map("purchase_receipt_lines")
}

model SalesDelivery {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String              @db.Uuid
  orderId                   String              @unique @db.Uuid
  contactId                 String              @db.Uuid
  number                    String              @db.VarChar(40)
  deliveryDate              DateTime            @db.Date
  sourceOrderNumberSnapshot String              @db.VarChar(40)
  sourceOrderDateSnapshot   DateTime            @db.Date
  contactNameSnapshot       String              @db.VarChar(160)
  createdById               String              @db.Uuid
  createdAt                 DateTime            @default(now()) @db.Timestamptz(6)
  business                  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order                     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contact                   Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy                 ApplicationUser     @relation("SalesDeliveryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines                     SalesDeliveryLine[]

  @@unique([businessId, number])
  @@index([businessId, deliveryDate])
  @@index([contactId])
  @@map("sales_deliveries")
}

model SalesDeliveryLine {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId          String             @db.Uuid
  sourceOrderLineId   String             @unique @db.Uuid
  productId           String             @db.Uuid
  productNameSnapshot String             @db.VarChar(160)
  productKindSnapshot ProductKind
  quantity            Decimal            @db.Decimal(16, 4)
  position            Int
  delivery            SalesDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  sourceOrderLine     OrderLine          @relation(fields: [sourceOrderLineId], references: [id], onDelete: Restrict)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement   InventoryMovement?

  @@unique([deliveryId, position])
  @@index([productId])
  @@map("sales_delivery_lines")
}

model InventoryMovement {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String               @db.Uuid
  productId             String               @db.Uuid
  purchaseReceiptLineId String?              @unique @db.Uuid
  salesDeliveryLineId   String?              @unique @db.Uuid
  movementDate          DateTime             @db.Date
  quantityDelta         Decimal              @db.Decimal(16, 4)
  productNameSnapshot   String               @db.VarChar(160)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product               Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceiptLine   PurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: Restrict)
  salesDeliveryLine     SalesDeliveryLine?   @relation(fields: [salesDeliveryLineId], references: [id], onDelete: Restrict)

  @@index([businessId, productId, movementDate])
  @@map("inventory_movements")
}

model FinancialDocument {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String                  @db.Uuid
  kind                      FinancialDocumentKind
  contactId                 String                  @db.Uuid
  sourceOrderId             String                  @db.Uuid
  number                    String                  @db.VarChar(40)
  documentDate              DateTime                @db.Date
  dueDate                   DateTime                @db.Date
  externalReference         String?                 @db.VarChar(160)
  contactNameSnapshot       String                  @db.VarChar(160)
  sourceOrderNumberSnapshot String                  @db.VarChar(40)
  state                     FinancialDocumentState  @default(DRAFT)
  netTotal                  Decimal                 @db.Decimal(20, 2)
  taxTotal                  Decimal                 @db.Decimal(20, 2)
  total                     Decimal                 @db.Decimal(20, 2)
  revision                  Int                     @default(1)
  journalEntryId            String?                 @unique @db.Uuid
  reversalEntryId           String?                 @unique @db.Uuid
  reversedAt                DateTime?               @db.Timestamptz(6)
  reversalReason            String?                 @db.VarChar(240)
  createdById               String                  @db.Uuid
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  business                  Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact                   Contact                 @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sourceOrder               Order                   @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  journalEntry              JournalEntry?           @relation("FinancialDocumentPosting", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalEntry             JournalEntry?           @relation("FinancialDocumentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  createdBy                 ApplicationUser         @relation("FinancialDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines                     FinancialDocumentLine[]
  paymentAttempts           PaymentAttempt[]
  allocations               PaymentAllocation[]

  @@unique([businessId, kind, number])
  @@index([businessId, kind, state, documentDate])
  @@index([contactId])
  @@index([sourceOrderId])
  @@map("financial_documents")
}

model FinancialDocumentLine {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId           String            @db.Uuid
  sourceOrderLineId    String            @db.Uuid
  productId            String            @db.Uuid
  productNameSnapshot  String            @db.VarChar(160)
  quantity             Decimal           @db.Decimal(16, 4)
  unitPriceSnapshot    Decimal           @db.Decimal(20, 4)
  lineNetTotal         Decimal           @db.Decimal(20, 2)
  taxId                String?           @db.Uuid
  taxNameSnapshot      String?           @db.VarChar(120)
  taxRateSnapshot      Decimal?          @db.Decimal(7, 4)
  taxRevisionSnapshot  Int?
  taxAccountIdSnapshot String?           @db.Uuid
  taxAmount            Decimal           @default(0) @db.Decimal(20, 2)
  lineTotal            Decimal           @db.Decimal(20, 2)
  analyticAccountId    String?           @db.Uuid
  position             Int
  document             FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sourceOrderLine      OrderLine         @relation(fields: [sourceOrderLineId], references: [id], onDelete: Restrict)
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  tax                  Tax?              @relation(fields: [taxId], references: [id], onDelete: Restrict)
  analyticAccount      AnalyticAccount?  @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)

  @@unique([documentId, position])
  @@unique([documentId, sourceOrderLineId])
  @@index([productId])
  @@index([taxId])
  @@index([analyticAccountId])
  @@map("financial_document_lines")
}

model LedgerAccount {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId               String         @db.Uuid
  code                     String         @db.VarChar(32)
  name                     String         @db.VarChar(160)
  type                     AccountType
  subtype                  AccountSubtype @default(GENERAL)
  revision                 Int            @default(1)
  archivedAt               DateTime?      @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(6)
  business                 Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  incomeJournalDefaults    Journal[]      @relation("JournalIncomeAccount")
  expenseJournalDefaults   Journal[]      @relation("JournalExpenseAccount")
  controlJournalDefaults   Journal[]      @relation("JournalControlAccount")
  liquidityJournalDefaults Journal[]      @relation("JournalLiquidityAccount")
  taxInputs                Tax[]          @relation("TaxInputAccount")
  taxOutputs               Tax[]          @relation("TaxOutputAccount")
  journalItems             JournalItem[]

  @@unique([businessId, code])
  @@index([businessId, type, archivedAt])
  @@map("ledger_accounts")
}

model Journal {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String         @db.Uuid
  code                      String         @db.VarChar(16)
  name                      String         @db.VarChar(120)
  type                      JournalType
  defaultIncomeAccountId    String?        @db.Uuid
  defaultExpenseAccountId   String?        @db.Uuid
  defaultControlAccountId   String?        @db.Uuid
  defaultLiquidityAccountId String?        @db.Uuid
  revision                  Int            @default(1)
  archivedAt                DateTime?      @db.Timestamptz(6)
  createdAt                 DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime       @updatedAt @db.Timestamptz(6)
  business                  Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  defaultIncomeAccount      LedgerAccount? @relation("JournalIncomeAccount", fields: [defaultIncomeAccountId], references: [id], onDelete: Restrict)
  defaultExpenseAccount     LedgerAccount? @relation("JournalExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)
  defaultControlAccount     LedgerAccount? @relation("JournalControlAccount", fields: [defaultControlAccountId], references: [id], onDelete: Restrict)
  defaultLiquidityAccount   LedgerAccount? @relation("JournalLiquidityAccount", fields: [defaultLiquidityAccountId], references: [id], onDelete: Restrict)
  entries                   JournalEntry[]
  payments                  Payment[]

  @@unique([businessId, code])
  @@index([businessId, type, archivedAt])
  @@map("journals")
}

model Tax {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String                  @db.Uuid
  name                   String                  @db.VarChar(120)
  rate                   Decimal                 @db.Decimal(7, 4)
  scope                  TaxScope
  inputAccountId         String?                 @db.Uuid
  outputAccountId        String?                 @db.Uuid
  revision               Int                     @default(1)
  archivedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inputAccount           LedgerAccount?          @relation("TaxInputAccount", fields: [inputAccountId], references: [id], onDelete: Restrict)
  outputAccount          LedgerAccount?          @relation("TaxOutputAccount", fields: [outputAccountId], references: [id], onDelete: Restrict)
  financialDocumentLines FinancialDocumentLine[]
  orderLines             OrderLine[]

  @@unique([businessId, name])
  @@index([businessId, archivedAt])
  @@map("taxes")
}

model AnalyticAccount {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String                  @db.Uuid
  name                   String                  @db.VarChar(120)
  type                   AnalyticType
  revision               Int                     @default(1)
  archivedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  budgetLines            BudgetLine[]
  journalItems           JournalItem[]
  financialDocumentLines FinancialDocumentLine[]
  orderLines             OrderLine[]

  @@unique([businessId, name])
  @@index([businessId, type, archivedAt])
  @@map("analytic_accounts")
}

model Budget {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId              String          @db.Uuid
  name                    String          @db.VarChar(160)
  startsOn                DateTime        @db.Date
  endsOn                  DateTime        @db.Date
  responsibleUserId       String          @db.Uuid
  responsibleNameSnapshot String          @db.VarChar(160)
  revision                Int             @default(1)
  archivedAt              DateTime?       @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(6)
  business                Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  responsibleUser         ApplicationUser @relation("BudgetResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  lines                   BudgetLine[]

  @@unique([businessId, name, startsOn, endsOn])
  @@index([businessId, startsOn, endsOn])
  @@map("budgets")
}

model BudgetLine {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetId          String          @db.Uuid
  analyticAccountId String          @db.Uuid
  plannedAmount     Decimal         @db.Decimal(20, 2)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  budget            Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)

  @@unique([budgetId, analyticAccountId])
  @@map("budget_lines")
}

model FileAsset {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @db.Uuid
  storageKey   String   @unique @db.VarChar(512)
  mimeType     String   @db.VarChar(64)
  byteSize     Int
  width        Int
  height       Int
  verifiedAt   DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contactImage Contact? @relation("ContactImage")

  @@index([businessId])
  @@map("file_assets")
}

model JournalEntry {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String             @db.Uuid
  journalId                 String             @db.Uuid
  postingDate               DateTime           @db.Date
  reference                 String             @db.VarChar(160)
  state                     EntryState         @default(DRAFT)
  source                    EntrySource
  sourceReference           String?            @db.Uuid
  reversalOfEntryId         String?            @unique @db.Uuid
  createdById               String             @db.Uuid
  postedAt                  DateTime?          @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime           @updatedAt @db.Timestamptz(6)
  business                  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journal                   Journal            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy                 ApplicationUser    @relation("EntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf                JournalEntry?      @relation("EntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversedBy                JournalEntry?      @relation("EntryReversal")
  items                     JournalItem[]
  financialDocument         FinancialDocument? @relation("FinancialDocumentPosting")
  reversedFinancialDocument FinancialDocument? @relation("FinancialDocumentReversal")
  payment                   Payment?           @relation("PaymentPosting")
  reversedPayment           Payment?           @relation("PaymentReversal")

  @@index([businessId, postingDate, state])
  @@index([journalId, postingDate])
  @@map("journal_entries")
}

model JournalItem {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId           String           @db.Uuid
  accountId         String           @db.Uuid
  contactId         String?          @db.Uuid
  analyticAccountId String?          @db.Uuid
  description       String?          @db.VarChar(240)
  debit             Decimal          @default(0) @db.Decimal(20, 2)
  credit            Decimal          @default(0) @db.Decimal(20, 2)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account           LedgerAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact           Contact?         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId, entryId])
  @@index([contactId])
  @@map("journal_items")
}

model PaymentAttempt {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId               String               @db.Uuid
  documentId               String               @db.Uuid
  contactId                String               @db.Uuid
  direction                PaymentDirection
  sourceMode               PaymentSourceMode    @default(PORTAL_SIMULATION)
  status                   PaymentAttemptStatus @default(PENDING)
  amount                   Decimal              @db.Decimal(20, 2)
  paymentDate              DateTime             @db.Date
  failureCode              String?              @db.VarChar(64)
  expectedDocumentRevision Int
  revision                 Int                  @default(1)
  createdById              String               @db.Uuid
  createdAt                DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(6)
  business                 Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document                 FinancialDocument    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  contact                  Contact              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy                ApplicationUser      @relation("PaymentAttemptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payment                  Payment?

  @@index([businessId, status, createdAt])
  @@index([documentId, createdAt])
  @@map("payment_attempts")
}

model Payment {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String              @db.Uuid
  contactId           String              @db.Uuid
  journalId           String              @db.Uuid
  paymentAttemptId    String?             @unique @db.Uuid
  direction           PaymentDirection
  sourceMode          PaymentSourceMode
  status              PaymentStatus       @default(POSTED)
  number              String              @db.VarChar(40)
  paymentDate         DateTime            @db.Date
  amount              Decimal             @db.Decimal(20, 2)
  contactNameSnapshot String              @db.VarChar(160)
  externalReference   String?             @db.VarChar(160)
  journalEntryId      String              @unique @db.Uuid
  reversalEntryId     String?             @unique @db.Uuid
  reversalDate        DateTime?           @db.Date
  reversalReason      String?             @db.VarChar(240)
  revision            Int                 @default(1)
  createdById         String              @db.Uuid
  reversedById        String?             @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact             Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  journal             Journal             @relation(fields: [journalId], references: [id], onDelete: Restrict)
  paymentAttempt      PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  journalEntry        JournalEntry        @relation("PaymentPosting", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalEntry       JournalEntry?       @relation("PaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  createdBy           ApplicationUser     @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy          ApplicationUser?    @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  allocations         PaymentAllocation[]

  @@unique([businessId, direction, number])
  @@index([businessId, direction, paymentDate])
  @@index([contactId, paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String              @db.Uuid
  documentId    String              @db.Uuid
  amount        Decimal             @db.Decimal(20, 2)
  effectiveDate DateTime            @db.Date
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  document      FinancialDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reversal      AllocationReversal?

  @@unique([paymentId, documentId])
  @@index([documentId, effectiveDate])
  @@map("payment_allocations")
}

model AllocationReversal {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  allocationId  String            @unique @db.Uuid
  amount        Decimal           @db.Decimal(20, 2)
  effectiveDate DateTime          @db.Date
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  allocation    PaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  createdBy     ApplicationUser   @relation("AllocationReversalCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([effectiveDate])
  @@map("allocation_reversals")
}

model DocumentSequence {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String       @db.Uuid
  kind       SequenceKind
  period     String       @db.VarChar(16)
  prefix     String       @db.VarChar(24)
  nextNumber BigInt       @default(1)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, kind, period])
  @@map("document_sequences")
}

model CommandOperation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String           @db.Uuid
  actorUserId  String?          @db.Uuid
  operationKey String           @db.Uuid
  operation    String           @db.VarChar(80)
  requestHash  String           @db.Char(64)
  resourceId   String?          @db.Uuid
  result       Json?
  committedAt  DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor        ApplicationUser? @relation("CommandActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, operationKey])
  @@index([businessId, operation, createdAt])
  @@map("command_operations")
}

model AuditEvent {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String           @db.Uuid
  actorUserId String?          @db.Uuid
  action      String           @db.VarChar(100)
  targetType  String           @db.VarChar(80)
  targetId    String           @db.Uuid
  requestId   String           @db.Uuid
  details     Json?
  occurredAt  DateTime         @default(now()) @db.Timestamptz(6)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor       ApplicationUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}
